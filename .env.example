# Copy to .env and edit. NEVER commit .env. Do not paste these values into chat or issues.

# --- Local trial over plain http (docker compose up) ---------------------------
ENVIRONMENT=staging
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# --- Production (HTTPS only): use these instead ---------------------------------
# ENVIRONMENT=production
# COOKIE_SECURE=true
# PUBLIC_URL=https://churn.yourdomain.com

# Generate a strong value, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Trust X-Forwarded-For from the proxy in front of the app (Caddy / load balancer). The proxy must be the only
# way to reach the web app. TRUSTED_PROXY_HOPS = proxies in front that append the client address (usually 1).
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# Business policy: probability at/above this is "high" risk (model threshold is the lower bound of "medium").
RISK_HIGH_THRESHOLD=0.50

# Email (password reset, invitations, verification). "console" only logs the message: development only.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
