# Copy to .env (never commit .env). No secrets are required in Phase 1.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Business risk policy: probability at/above this value is "high" risk.
# Must be greater than the model threshold (model threshold). Placeholder pending approval.
RISK_HIGH_THRESHOLD=0.50

# --- Phase 2: database, sessions, email ---------------------------------
# Production MUST use PostgreSQL, COOKIE_SECURE=true and SMTP email.
DATABASE_URL=sqlite:///./churn_dev.db
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*
TRUST_PROXY_HEADERS=false
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
